# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/baig-tours?retryWrites=true&w=majority

# JWT
JWT_SECRET=your-secret-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:3000

# SMTP (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email
EMAIL_FROM=noreply@baigtourspakistan.pk
COMPANY_EMAIL=info@baigtourspakistan.pk
COMPANY_NAME=Baig Tours Pakistan

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
SANITY_API_TOKEN=
